# ═══════════════════════════════════════════════════════════════
# 视觉引导机器人操控系统 — 环境变量模板
# ═══════════════════════════════════════════════════════════════
# 复制为 .env 并填入实际值:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# DeepSeek API (必填 — 从 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 服务端口 (通常不需要修改)
VISION_PORT=8801
ROBOT_PORT=8802
AGENT_PORT=8803
WEB_PORT=8800

# 服务间通信 URL (生产环境用 127.0.0.1)
VISION_URL=http://127.0.0.1:8801
ROBOT_URL=http://127.0.0.1:8802

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
